# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API).
# Seule la clé publique "anon" va ici. Ne JAMAIS mettre la clé service_role dans le frontend.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Notifications push : clé publique VAPID (la clé privée va uniquement dans les secrets de la fonction Edge send-push)
VITE_VAPID_PUBLIC_KEY=
